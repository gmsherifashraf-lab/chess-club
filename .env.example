# Copy to .env.local and fill in. .env.local is gitignored.

# Public — safe to expose to the browser (new sb_publishable_* short key,
# NOT the legacy JWT anon key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server ONLY — never prefix with NEXT_PUBLIC, never expose to the client.
# Supabase dashboard → Project Settings → API → service_role secret.
# Required by /api/admin/create-user (the only account-creation path).
SUPABASE_SERVICE_ROLE_KEY=
